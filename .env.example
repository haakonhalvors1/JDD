# Kopier til .env.local for å koble prototypen til Supabase lokalt.
# Finnes i Supabase: Project Settings → API (Project URL og publishable/anon key).
# Den publiserbare nøkkelen er laget for å ligge i nettleseren. Bruk ALDRI service_role/secret-nøkkelen her.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
